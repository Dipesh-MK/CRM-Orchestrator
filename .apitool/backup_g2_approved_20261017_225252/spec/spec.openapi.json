{
  "openapi": "3.0.3",
  "info": {
    "title": "Mock Aggregator — Twilio-Compatible SMS API",
    "version": "1.0.0",
    "description": "Drop-in mock aggregator simulating Twilio's Programmable SMS API with multi-tenant account isolation (IDACT, PBT), shortcode validation, deterministic delivery simulation (numbers ending in 0 -> undelivered, 1-9 -> delivered), StatusCallback webhooks, raw wire payload inspection, and two-way inbound SMS replies."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local Mock Aggregator instance"
    }
  ],
  "tags": [
    {
      "name": "Twilio Programmable SMS",
      "description": "Twilio-compatible REST API endpoints (authenticate with AccountSid and AuthToken)"
    },
    {
      "name": "Admin & Telemetry",
      "description": "Aggregator management, stats, live message stream, and wire inspection"
    },
    {
      "name": "Virtual Phone Simulator",
      "description": "Virtual phone identities, conversation threads, and two-way inbound replies"
    }
  ],
  "paths": {
    "/2010-04-01/Accounts/{AccountSid}/Messages.json": {
      "post": {
        "tags": [
          "Twilio Programmable SMS"
        ],
        "summary": "Send an SMS (Twilio POST /Messages.json)",
        "description": "Sends an SMS through the Mock Aggregator. The account SID and AuthToken are validated via HTTP Basic Auth. The 'From' parameter must be an active shortcode belonging to the account. Delivery status is deterministically simulated: numbers ending in 0 transition to 'undelivered' (Error 30008); numbers ending in 1-9 transition to 'delivered'.",
        "security": [
          {
            "BasicAuth": []
          }
        ],
        "parameters": [
          {
            "name": "AccountSid",
            "in": "path",
            "required": true,
            "description": "Account SID (e.g., AC_IDACT_001 or AC_PBT_002)",
            "schema": {
              "type": "string",
              "example": "AC_IDACT_001"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "To",
                  "From",
                  "Body"
                ],
                "properties": {
                  "To": {
                    "type": "string",
                    "description": "Destination phone number (+E.164). Numbers ending in 0 trigger simulated failure.",
                    "example": "+15551234561"
                  },
                  "From": {
                    "type": "string",
                    "description": "Shortcode owned by the account (IDACT: 55512, 55513 | PBT: 88820, 88821)",
                    "example": "55512"
                  },
                  "Body": {
                    "type": "string",
                    "description": "Text message content (up to 1600 characters)",
                    "example": "Your verification code is 492102. Valid for 5 minutes."
                  },
                  "StatusCallback": {
                    "type": "string",
                    "description": "Optional webhook URL to receive asynchronous delivery receipts (DLR)",
                    "example": "https://webhook.site/test-dlr"
                  }
                }
              }
            },
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "To",
                  "From",
                  "Body"
                ],
                "properties": {
                  "To": {
                    "type": "string",
                    "example": "+15551234561"
                  },
                  "From": {
                    "type": "string",
                    "example": "55512"
                  },
                  "Body": {
                    "type": "string",
                    "example": "Your verification code is 492102."
                  },
                  "StatusCallback": {
                    "type": "string",
                    "example": "https://webhook.site/test-dlr"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Message queued successfully (Twilio 201 Created envelope)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TwilioMessageResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid shortcode or missing To/From"
          },
          "401": {
            "description": "Authentication failure (invalid SID or AuthToken)"
          }
        },
        "x-source": "vendor-openapi: src/docs/openapi.json",
        "x-auth": "basic",
        "x-confidence": "vendor-documented"
      }
    },
