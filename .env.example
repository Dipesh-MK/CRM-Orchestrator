# LLM Configuration (Groq API)
# Get your free API key at https://console.groq.com/
GROQ_API_KEY=

# Optional overrides (defaults already set to Groq in config/app.yaml)
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TEMPERATURE=
LLM_TIMEOUT=

# Orchestrator Configuration
WORD_LIMIT=
MAX_RETRIES=
MAX_DISCOVERY_ROUNDS=
OPTOUT_TEXT=
DEFAULT_WORKSPACE_ID=

# Storage & Paths
DATABASE_PATH=
LOGS_DIR=
PROMPTS_DIR=
SUPPRESSION_FILE=

# Provider Integration (Aggregator)
APITOOL_BASE_URL=
AGGREGATOR_ACCOUNT_SID=
AGGREGATOR_AUTH_TOKEN=
AGGREGATOR_FROM_NUMBER=
